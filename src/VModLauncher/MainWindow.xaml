<Window x:Class="VModLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="V Mod Launcher"
        Width="1320" Height="840" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Icon="app.ico">
    <Grid>
        <TextBlock x:Name="Loading" Text="Starting…" Foreground="#8A8A99" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <wv2:WebView2 x:Name="Ui" DefaultBackgroundColor="#000000" />
    </Grid>
</Window>
