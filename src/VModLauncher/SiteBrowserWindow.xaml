<Window x:Class="VModLauncher.SiteBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Mod site" Width="1180" Height="820" MinWidth="720" MinHeight="520"
        Background="#000000" WindowStartupLocation="CenterOwner" Icon="app.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8E8F0" />
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D0D0D" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="Back" Click="Back_Click" />
                    <Button Content="Reload" Click="Reload_Click" />
                    <Button Content="Open in my browser" Click="External_Click" />
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="Heading" Foreground="#F2F2F7" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Address" Foreground="#7C7C8E" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- GTA V pause-menu look: black bar, money-green edge -->
        <Border Grid.Row="1" x:Name="Banner" Padding="14,9" Background="#E6000000" BorderBrush="#72CC72" BorderThickness="3,0,0,0">
            <DockPanel>
                <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="180" Height="6" Margin="12,0,0,0"
                             Visibility="Collapsed" Foreground="#72CC72" Background="#2A2A2A" BorderThickness="0" />
                <TextBlock x:Name="Status" Foreground="#F2F2F7" FontSize="13" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <wv2:WebView2 Grid.Row="2" x:Name="View" DefaultBackgroundColor="#FFFFFF" />
    </Grid>
</Window>
